{
  "name": "mervikon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node -- scripts/start.mjs",
    "build": "tsc --noEmit && vite build",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "mervikon": "node scripts/mervikon.mjs",
    "build:all": "tsc --noEmit && node scripts/build-frontends.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "format": "prettier --write \"src/apps/**/*.{ts,tsx,css,html}\" \"scripts/*.mjs\" \"tests/tooling/*.mjs\" \"*.{json,ts}\" \"labs/**/*.{mjs,js,css,html}\"",
    "format:check": "prettier --check \"src/apps/**/*.{ts,tsx,css,html}\" \"scripts/*.mjs\" \"tests/tooling/*.mjs\" \"*.{json,ts}\" \"labs/**/*.{mjs,js,css,html}\"",
    "check": "npm run format:check && npm run check:repository && npm run test:tooling && npm run build:all"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
