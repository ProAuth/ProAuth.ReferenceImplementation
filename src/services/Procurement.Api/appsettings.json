{
  "AllowedHosts": "procurement.localtest.me",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ResourceServer": {
    "Authority": "",
    "Audience": "urn:mervikon:procurement",
    "RequireHttpsMetadata": true,
    "AccessTokenPresentationPolicy": "DpopRequired"
  },
  "OutboundAuthentication": {
    "Authority": "",
    "ClientId": "",
    "ClientSecret": "",
    "ClientAuthenticationMethod": "ClientSecretBasic",
    "SenderConstrainedTokenMode": "Dpop",
    "Dpop": {
      "SigningAlgorithm": "PS256",
      "GenerateEphemeralKeyWhenMissing": false
    }
  }
}
