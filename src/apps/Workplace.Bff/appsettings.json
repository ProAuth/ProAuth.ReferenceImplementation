{
  "AllowedHosts": "workplace.localtest.me",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ProAuthBff": {
    "LogoutConfirmationViewName": "~/Views/Account/Logout.cshtml",
    "SessionTimeoutInMinutes": 30,
    "ForwardedHeaders": {
      "UseForwardedHeaders": true,
      "ForwardLimit": 1,
      "KnownNetworks": "",
      "KnownProxies": ""
    },
    "AuthenticationSettings": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "ClientAuthenticationMethod": "ClientSecretBasic",
      "TenantId": "",
      "UserScopes": "openid profile offline_access procurement.read procurement.write",
      "UserResources": "urn:mervikon:procurement",
      "PushedAuthorizationBehavior": "Require",
      "SenderConstrainedTokenMode": "Dpop",
      "Dpop": {
        "SigningAlgorithm": "PS256",
        "GenerateEphemeralKeyWhenMissing": false
      }
    },
    "Routes": [
      {
        "RouteId": "procurement",
        "Path": "/api/{**catch-all}",
        "Destination": "https://procurement.localtest.me",
        "InjectToken": true,
        "AccessTokenForwardingMode": "Automatic",
        "TransparentProxy": false,
        "PreventRedirectToLogin": true,
        "AllowAnonymous": false,
        "AuthorizationPolicy": "authenticated-user"
      }
    ],
    "DataProtectionSettings": {
      "ApplicationName": "mervikon-workplace",
      "Enabled": true,
      "EncryptionKeys": {
        "Mode": "X509"
      }
    },
    "Redis": {
      "Cache": {
        "ConnectionString": "mervikon-redis:6379"
      },
      "TicketStore": {
        "ApplicationName": "mervikon-workplace",
        "ConnectionString": "mervikon-redis:6379",
        "KeyPrefix": "mervikon:workplace:tickets:"
      },
      "DistributedLock": {
        "ConnectionString": "mervikon-redis:6379",
        "KeyPrefix": "mervikon:workplace:lock:"
      },
      "DataProtection": {
        "ConnectionString": "mervikon-redis:6379",
        "InstanceName": "mervikon:workplace:"
      }
    },
    "TlsCertificateValidation": {
      "AcceptAnyServerCertificates": false
    },
    "BackChannelLogout": {
      "Enabled": true
    },
    "StepUpPolicies": {
      "approve-purchase": {
        "Audience": "urn:mervikon:procurement",
        "AcceptedAcrValues": [
          "https://proauth.net/acr/mfa",
          "phr"
        ],
        "MaximumAgeSeconds": 0
      }
    }
  }
}
