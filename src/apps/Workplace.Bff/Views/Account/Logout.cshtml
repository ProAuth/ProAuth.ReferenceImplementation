@model ProAuth.Bff.Models.LogoutConfirmationViewModel
@using System.Text.Json
@{
    Layout = null;
    using var catalogue = JsonDocument.Parse(await System.IO.File.ReadAllTextAsync(System.IO.Path.Combine(AppContext.BaseDirectory, "catalogue.json")));
    var company = catalogue.RootElement.GetProperty("company");
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign out · Workplace</title>
    <link rel="stylesheet" href="@Url.Content("~/mervikon-shell.css")">
</head>
<body>
    <div class="workspace">
        <aside>
            <a class="brand" href="@Url.Content("~/")">@company.GetProperty("displayName").GetString()</a>
            <span class="eyebrow">Workplace</span>
            <p class="fiction">@company.GetProperty("notice").GetString()</p>
        </aside>
        <main>
            <header>Procurement / Workplace</header>
            <section class="intro">
                <h1>Sign out</h1>
                <p>Choose whether to keep your ProAuth session available for other apps or end it when you leave Workplace.</p>
                <form class="step-up-actions" method="post" action="@Model.LogoutAction">
                    <input type="hidden" name="@Model.AntiforgeryFieldName" value="@Model.AntiforgeryToken">
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                    <button type="submit" name="logoutMode" value="app">Sign out of Workplace only</button>
                    <button type="submit" name="logoutMode" value="sso">Sign out of Workplace and ProAuth</button>
                    <a href="@Model.ReturnUrl">Cancel</a>
                </form>
            </section>
        </main>
    </div>
</body>
</html>
