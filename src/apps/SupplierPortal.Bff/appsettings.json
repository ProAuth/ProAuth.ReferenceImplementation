{
  "AllowedHosts": "supplier.localtest.me",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ProAuthBff": {
    "LogoutConfirmationViewName": "~/Views/Account/Logout.cshtml",
    "SessionTimeoutInMinutes": 30,
    "ForwardedHeaders": {
      "UseForwardedHeaders": true,
      "ForwardLimit": 1,
      "KnownNetworks": "",
      "KnownProxies": ""
    },
    "AuthenticationSettings": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "ClientAuthenticationMethod": "ClientSecretBasic",
      "TenantId": "",
      "UserScopes": "openid profile offline_access fulfilment.read fulfilment.write",
      "UserResources": "urn:mervikon:fulfilment",
      "PushedAuthorizationBehavior": "Require"
    },
    "Routes": [
      {
        "RouteId": "fulfilment",
        "Path": "/api/{**catch-all}",
        "Destination": "https://fulfilment.localtest.me",
        "InjectToken": true,
        "AccessTokenForwardingMode": "Automatic",
        "TransparentProxy": false,
        "PreventRedirectToLogin": true,
        "AllowAnonymous": false,
        "AuthorizationPolicy": "authenticated-user"
      }
    ],
    "DataProtectionSettings": {
      "ApplicationName": "mervikon-supplier",
      "Enabled": true,
      "EncryptionKeys": {
        "Mode": "X509"
      }
    },
    "Redis": {
      "Cache": {
        "ConnectionString": "mervikon-redis:6379"
      },
      "TicketStore": {
        "ApplicationName": "mervikon-supplier",
        "ConnectionString": "mervikon-redis:6379",
        "KeyPrefix": "mervikon:supplier:tickets:"
      },
      "DistributedLock": {
        "ConnectionString": "mervikon-redis:6379",
        "KeyPrefix": "mervikon:supplier:lock:"
      },
      "DataProtection": {
        "ConnectionString": "mervikon-redis:6379",
        "InstanceName": "mervikon:supplier:"
      }
    },
    "TlsCertificateValidation": {
      "AcceptAnyServerCertificates": false
    },
    "BackChannelLogout": {
      "Enabled": true
    }
  }
}
