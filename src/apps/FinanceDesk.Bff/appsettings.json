{
  "AllowedHosts": "finance.localtest.me",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ProAuthBff": {
    "LogoutConfirmationViewName": "~/Views/Account/Logout.cshtml",
    "SessionTimeoutInMinutes": 30,
    "ForwardedHeaders": {
      "UseForwardedHeaders": true,
      "ForwardLimit": 1,
      "KnownNetworks": "",
      "KnownProxies": ""
    },
    "AuthenticationSettings": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "ClientAuthenticationMethod": "PrivateKeyJwt",
      "TenantId": "",
      "UserScopes": "openid profile offline_access treasury.read treasury.write",
      "UserResources": "urn:mervikon:treasury",
      "PushedAuthorizationBehavior": "Require",
      "SenderConstrainedTokenMode": "Dpop",
      "Dpop": {
        "GenerateEphemeralKeyWhenMissing": false,
        "SigningAlgorithm": "PS256",
        "RetryWithNonce": true
      },
      "SecurityProfile": "Fapi2SecurityProfile",
      "ClientAssertion": {
        "SigningAlgorithm": "PS256",
        "KeyId": "mervikon-finance-assertion-rsa",
        "LifetimeInSeconds": 60
      }
    },
    "Routes": [
      {
        "RouteId": "treasury",
        "Path": "/api/{**catch-all}",
        "Destination": "https://treasury.localtest.me",
        "InjectToken": true,
        "AccessTokenForwardingMode": "Automatic",
        "TransparentProxy": false,
        "PreventRedirectToLogin": true,
        "AllowAnonymous": false,
        "AuthorizationPolicy": "authenticated-user"
      }
    ],
    "DataProtectionSettings": {
      "ApplicationName": "mervikon-finance",
      "Enabled": true,
      "EncryptionKeys": {
        "Mode": "X509"
      }
    },
    "Redis": {
      "Cache": {
        "ConnectionString": "mervikon-redis:6379"
      },
      "TicketStore": {
        "ApplicationName": "mervikon-finance",
        "ConnectionString": "mervikon-redis:6379",
        "KeyPrefix": "mervikon:finance:tickets:"
      },
      "DistributedLock": {
        "ConnectionString": "mervikon-redis:6379",
        "KeyPrefix": "mervikon:finance:lock:"
      },
      "DataProtection": {
        "ConnectionString": "mervikon-redis:6379",
        "InstanceName": "mervikon:finance:"
      }
    },
    "TlsCertificateValidation": {
      "AcceptAnyServerCertificates": false
    },
    "BackChannelLogout": {
      "Enabled": true
    },
    "StepUpPolicies": {
      "release-payment": {
        "Audience": "urn:mervikon:treasury",
        "AcceptedAcrValues": [
          "https://proauth.net/acr/mfa",
          "phr"
        ],
        "MaximumAgeSeconds": 0
      }
    }
  }
}
