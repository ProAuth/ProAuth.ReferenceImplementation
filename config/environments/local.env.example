# Settings reference for a shared proxy. Generate your private environment with npm start.
COMPOSE_PROJECT_NAME=mervikon
PROXY_MODE=shared
CLI_MODE=container
MERVIKON_EDGE_NETWORK=YOUR_SHARED_PROXY_NETWORK
TRUSTED_PROXY_IP=SET_EXACT_PROXY_IP
PROAUTH_HOST=https://idp.localtest.me
PROAUTH_ISSUER=https://idp.localtest.me
WORKPLACE_HOST=workplace.localtest.me
WORKPLACE_ORIGIN=https://workplace.localtest.me
PROCUREMENT_HOST=procurement.localtest.me
PROCUREMENT_ORIGIN=https://procurement.localtest.me
WORKPLACE_CLIENT_ID=FROM_CONFIG_PROAUTH_OWNERSHIP_JSON
WORKFORCE_TENANT_ID=FROM_CONFIG_PROAUTH_OWNERSHIP_JSON
WORKPLACE_CLIENT_SECRET=GENERATE_ONCE
DATA_PROTECTION_CERTIFICATE=GENERATE_ONCE_WITH_PROAUTH_CLI
DATA_PROTECTION_PASSWORD=GENERATE_ONCE_WITH_PROAUTH_CLI
INITIAL_USER_PASSWORD=GENERATE_ONCE
# Builds read customer feed credentials from .local/nuget.customer.config (see docs/development.md).
TRUSTED_CA_FILE=/absolute/path/rootCA.pem
TLS_CERT_FILE=/absolute/path/localtest.me.crt
TLS_KEY_FILE=/absolute/path/localtest.me.key
ENTITLEMENT_DIR=/absolute/private/path/entitlements
BOOTSTRAP_ENV_FILE=/absolute/private/path/bootstrap.env
BOOTSTRAP_SECRET_KEY=BOOTSTRAP_SECRET
BOOTSTRAP_CLIENT_ID=00000000-0000-0000-0000-000000000001
MERVIKON_MANUFACTURING_CONNECTION_STRING=DEDICATED_DATABASE_CONNECTION
MERVIKON_RESEARCH_CONNECTION_STRING=DEDICATED_DATABASE_CONNECTION
MERVIKON_PARTNERS_CONNECTION_STRING=DEDICATED_DATABASE_CONNECTION

# Workflow endpoints and registrations; configure-workflows generates missing values without rotation.
SUPPLIER_HOST=supplier.localtest.me
SUPPLIER_ORIGIN=https://supplier.localtest.me
FINANCE_HOST=finance.localtest.me
FINANCE_ORIGIN=https://finance.localtest.me
FULFILMENT_HOST=fulfilment.localtest.me
FULFILMENT_ORIGIN=https://fulfilment.localtest.me
TREASURY_HOST=treasury.localtest.me
TREASURY_ORIGIN=https://treasury.localtest.me
PARTNERS_TENANT_ID=FROM_OWNERSHIP
SUPPLIER_CLIENT_ID=FROM_OWNERSHIP
SUPPLIER_CLIENT_SECRET=GENERATE_ONCE
FINANCE_CLIENT_ID=FROM_OWNERSHIP
PROCUREMENT_EXCHANGE_CLIENT_ID=FROM_OWNERSHIP
PROCUREMENT_EXCHANGE_CLIENT_SECRET=GENERATE_ONCE
TREASURY_READER_CLIENT_ID=FROM_OWNERSHIP
TREASURY_READER_CLIENT_SECRET=GENERATE_ONCE
DISPATCH_CLIENT_ID=FROM_OWNERSHIP
DISPATCH_CLIENT_SECRET=GENERATE_ONCE
RECONCILIATION_CLIENT_ID=FROM_OWNERSHIP
RECONCILIATION_CLIENT_SECRET=GENERATE_ONCE
WAREHOUSE_CLIENT_ID=FROM_OWNERSHIP
SUPPLIER_DATA_PROTECTION_CERTIFICATE=GENERATE_KEYS
SUPPLIER_DATA_PROTECTION_PASSWORD=GENERATE_KEYS
FINANCE_DATA_PROTECTION_CERTIFICATE=GENERATE_KEYS
FINANCE_DATA_PROTECTION_PASSWORD=GENERATE_KEYS
FINANCE_DPOP_JWK=GENERATE_KEYS
FINANCE_ASSERTION_CERTIFICATE=GENERATE_KEYS
FINANCE_ASSERTION_PASSWORD=GENERATE_KEYS
FINANCE_ASSERTION_PUBLIC_JWKS=GENERATE_KEYS

# Local operator Console; never publish its ingestion listener.
DEMO_CONSOLE_HOST=democonsole.localtest.me
DEMO_CONSOLE_PORT=5080
EVIDENCE_PUBLISHER_KEY=GENERATE_ONCE
LAB_RESULTS_FILE=/absolute/path/.local/evidence/lab-comparison.json

# Optional isolated lab. Manifests and Compose services require --lab.
LAB_TENANT_ID=FROM_OWNERSHIP
LAB_BEARER_CLIENT_ID=FROM_OWNERSHIP
LAB_BEARER_CLIENT_SECRET=GENERATE_ONCE
LAB_DPOP_CLIENT_ID=FROM_OWNERSHIP
LAB_DPOP_CLIENT_SECRET=GENERATE_ONCE
LAB_CONTROL_KEY=GENERATE_ONCE
LAB_TLS_CERT_FILE=/absolute/path/.local/lab.crt
LAB_TLS_KEY_FILE=/absolute/path/.local/lab.key
LAB_TLS_CERTIFICATE_PEM=CONFIGURE_LAB_BASE64
LAB_TLS_PRIVATE_KEY_PEM=CONFIGURE_LAB_BASE64


# Optional local protocol controls; requires --protocols and configure-protocols.
CONTROL_RESULTS_FILE=/absolute/path/.local/evidence/control-comparisons.json
PROTOCOL_ISSUER=https://idp.localtest.me/mervikon-protocols
PROTOCOL_HOST=protocols.localtest.me
PROTOCOL_ORIGIN=https://protocols.localtest.me
PROTOCOL_TENANT_ID=FROM_OWNERSHIP
PROTOCOL_JWT_CLIENT_ID=FROM_OWNERSHIP
PROTOCOL_JWT_SECRET=GENERATE_ONCE
PROTOCOL_OPAQUE_CLIENT_ID=FROM_OWNERSHIP
PROTOCOL_OPAQUE_SECRET=GENERATE_ONCE
PROTOCOL_JWE_CLIENT_ID=FROM_OWNERSHIP
PROTOCOL_JWE_SECRET=GENERATE_ONCE
PROTOCOL_JWE_PRIVATE_JWK=CONFIGURE_PROTOCOLS
PROTOCOL_JWE_PUBLIC_JWKS=CONFIGURE_PROTOCOLS
PROTOCOL_MTLS_CLIENT_ID=FROM_OWNERSHIP
PROTOCOL_MTLS_CERTIFICATE=CONFIGURE_PROTOCOLS
PROTOCOL_MTLS_PASSWORD=CONFIGURE_PROTOCOLS
PROTOCOL_MTLS_PUBLIC_JWKS=CONFIGURE_PROTOCOLS
PROTOCOL_INTROSPECTION_CLIENT_ID=FROM_OWNERSHIP
PROTOCOL_INTROSPECTION_SECRET=GENERATE_ONCE

# Independent persistent sender keys for the BFF and receiving API.
WORKPLACE_DPOP_JWK=GENERATE_KEYS
PROCUREMENT_DPOP_JWK=GENERATE_KEYS
