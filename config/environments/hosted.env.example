# npm start generates the standalone proxy settings below. Set the hosted issuer in the generated private file.
# Hosted ProAuth dependency; this does not enable a public reference showcase.
PROXY_MODE=standalone
MERVIKON_EDGE_NETWORK=mervikon-edge
MERVIKON_EDGE_SUBNET=172.31.251.0/24
TRUSTED_PROXY_IP=172.31.251.2
PROAUTH_HOST=https://REPLACE_WITH_HOSTED_PROAUTH
PROAUTH_ISSUER=https://REPLACE_WITH_EXACT_DISCOVERY_ISSUER
# Use certificates/trust for your selected application hosts. Port 443 must be free.
