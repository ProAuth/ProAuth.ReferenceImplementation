<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="ProAuthFeed" value="https://packages.proauth.net/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="ProAuthFeed">
      <package pattern="ProAuth.*" />
      <package pattern="ReaFx.*" />
      <package pattern="4tecture.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
