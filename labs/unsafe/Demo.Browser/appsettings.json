{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "ProAuthBff": {
    "SessionTimeoutInMinutes": 30,
    "ForwardedHeaders": {
      "UseForwardedHeaders": true,
      "ForwardLimit": 1
    },
    "AuthenticationSettings": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "ClientAuthenticationMethod": "ClientSecretBasic",
      "TenantId": "",
      "UserScopes": "openid profile offline_access conference.quote",
      "UserResources": "urn:mervikon:conference",
      "PushedAuthorizationBehavior": "Require",
      "SenderConstrainedTokenMode": "None"
    },
    "Routes": [
      {
        "RouteId": "quote",
        "Path": "/api/{**catch-all}",
        "Destination": "",
        "InjectToken": true,
        "TransparentProxy": false,
        "PreventRedirectToLogin": true,
        "AllowAnonymous": false
      }
    ],
    "TlsCertificateValidation": {
      "AcceptAnyServerCertificates": false
    }
  }
}
